CREATE TABLE senha_usuario (
    id_senha SERIAL PRIMARY KEY,
    usuario VARCHAR(100) NOT NULL,
    senha_hash VARCHAR(255) NOT NULL,
    data_alteracao TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
