    id_favorito SERIAL PRIMARY KEY,
    usuario VARCHAR(100) NOT NULL,
    id_livro INT NOT NULL,
    data_favoritado TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    UNIQUE (usuario, id_livro)
);

